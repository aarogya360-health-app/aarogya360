# Supabase Configuration for Aarogya360
# Obtain these from your Supabase Project Settings -> API
# Note: NEVER expose your service_role secret in client-side code!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Application Mode ('production' | 'demo')
# When Supabase credentials are not set, Aarogya360 automatically runs in secure Demo/Offline Mode
VITE_APP_MODE=demo
